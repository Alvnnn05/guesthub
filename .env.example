# ==============================================================================
# GUESTHUB - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi '.env' di server fisik atau laptop lokal:
#   Linux/CentOS : cp .env.example .env
#   Windows      : copy .env.example .env
#
# ==============================================================================

# 1. Konfigurasi Port Host Server
HOST_DB_PORT=5433

# 2. Kredensial Database PostgreSQL
DB_NAME=guesthub_db
DB_USER=postgres
# Ganti dengan password yang kuat saat di server produksi
DB_PASSWORD=

# 3. Kunci Rahasia JWT (JSON Web Token)
# Generate string acak 64-byte hex di terminal: openssl rand -hex 64
JWT_SECRET=

# 4. Kebijakan CORS (Domain/Origin yang diizinkan mengakses API backend)
# Pisahkan dengan koma jika lebih dari satu (tanpa spasi setelah koma).
# Saat di server, tambahkan IP server atau domain resmi Dishub:
# Contoh: http://localhost:5173,http://localhost:8085,http://192.168.1.50:8085,https://bukutamu.dishub.ponorogo.go.id
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8085,http://127.0.0.1:8085

# 5. Reverse Proxy Setting (1 untuk Nginx)
TRUST_PROXY=1

